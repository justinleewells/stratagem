{
  "name": "stratagem",
  "version": "1.0.0",
  "description": "A data-driven library for simulating role-playing game battles",
  "keywords": [
    "turn-based",
    "tactical",
    "rpg",
    "battle",
    "typescript",
    "deterministic",
    "ai"
  ],
  "license": "MIT",
  "author": "Justin Wells <justinleewells@icloud.com> (http://wwww.justinleewells.com)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "mocha --loader=ts-node/esm test/**/*.test.ts",
    "test:watch": "mocha --loader=ts-node/esm --watch test/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "chai": "^6.2.2",
    "eslint": "^8.56.0",
    "mocha": "^11.7.5",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  }
}
